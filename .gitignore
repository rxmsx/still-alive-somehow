# macOS
.DS_Store

# Editors and IDEs
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Keep shared VS Code project hints, ignore local workspace state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Unreal generated project files
*.sln
*.xcworkspace
*.xcodeproj

# Unreal generated build and cache output
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Script/

# Unreal local editor/user content
Content/Collections/
Content/Developers/

# Unreal plugin generated output
Plugins/*/Binaries/
Plugins/*/Intermediate/
Plugins/*/Saved/

# Logs and local runtime output
*.log
*.tmp

# Python editor tooling cache
__pycache__/
*.py[cod]

# Local environment files
.env
.envrc
